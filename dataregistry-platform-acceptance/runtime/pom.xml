<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.dataregistry</groupId>
        <artifactId>dataregistry-platform-acceptance</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>dataregistry-platform-acceptance-runtime</artifactId>
    <packaging>pom</packaging>
    <name>DataRegistry Platform Acceptance Runtime Gate</name>
    <dependencies>
        <dependency>
            <groupId>nl.hauntedmc.dataprovider</groupId>
            <artifactId>dataprovider-platform-paper</artifactId>
            <version>${dataprovider.version}</version>
            <classifier>bundled</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>nl.hauntedmc.dataprovider</groupId>
            <artifactId>dataprovider-platform-velocity</artifactId>
            <version>${dataprovider.version}</version>
            <classifier>bundled</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>platform-acceptance</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${maven.exec.version}</version>
                        <executions>
                            <execution>
                                <id>boot-bundled-platform-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/dataregistry-platform-acceptance/run-platform-acceptance.sh</argument>
                                    </arguments>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
