<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.hauntedmc.platform</groupId>
        <artifactId>haunted-library-parent</artifactId>
        <version>1.2.0</version>
        <relativePath/>
    </parent>

    <groupId>nl.hauntedmc.dataregistry</groupId>
    <artifactId>dataregistry-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>DataRegistry</name>
    <description>Keeps up-to-date player data records, game-state metadata, and related events.</description>
    <url>https://github.com/HauntedMC/DataRegistry</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - DataRegistry</name>
            <url>https://maven.pkg.github.com/HauntedMC/DataRegistry</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>dataregistry-api</module>
        <module>dataregistry-platform-common</module>
        <module>dataregistry-core</module>
        <module>dataregistry-platform-velocity</module>
        <module>dataregistry-platform-paper</module>
        <module>dataregistry-testkit</module>
    </modules>

    <properties>
        <!-- Project identity and compiler configuration. -->
        <revision>1.14.4</revision>
        <!-- Runtime and platform APIs. -->
        <dataprovider.version>3.2.0</dataprovider.version>
        <hauntedmc-theme.version>1.0.0</hauntedmc-theme.version>
        <jakarta.persistence.version>${haunted.jpa.version}</jakarta.persistence.version>
        <paper.version>26.2.build.112-stable</paper.version>
        <paper.runtime.version>26.2</paper.runtime.version>
        <paper.runtime.build>65</paper.runtime.build>
        <paper.runtime.sha256>d290ee2a3ae92fea10afb0c74f797023d74cfd72cbcee44314e0c50d5551f2c6</paper.runtime.sha256>
        <velocity.version>4.1.0-SNAPSHOT</velocity.version>
        <velocity.runtime.build>9</velocity.runtime.build>
        <velocity.runtime.sha256>635ffe27b4fe1b97e61479012121d4e7c61a9eec99e6bd5a1f923053c2a259ce</velocity.runtime.sha256>
        <adventure.version>${haunted.adventure.version}</adventure.version>
        <!-- Test libraries. -->
        <junit.version>${haunted.junit.version}</junit.version>
        <mockito.version>${haunted.mockito.version}</mockito.version>
        <bytebuddy.version>1.18.12</bytebuddy.version>
    </properties>

    <repositories>
        <!-- Prefer Maven Central for public artifacts; GitHub hosts HauntedMC releases. -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/HauntedMC/*</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository><id>github</id><url>https://maven.pkg.github.com/HauntedMC/*</url></pluginRepository>
    </pluginRepositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>enforce-coverage-minimum</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.15</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <version>${duplicate.finder.version}</version>
                <executions>
                    <execution>
                        <id>reject-duplicate-classes</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <failBuildInCaseOfDifferentContentConflict>true</failBuildInCaseOfDifferentContentConflict>
                            <failBuildInCaseOfEqualContentConflict>true</failBuildInCaseOfEqualContentConflict>
                            <!-- DataProvider's test-only runtime dependency has its own unrelated default config. -->
                            <ignoredResourcePatterns>
                                <ignoredResourcePattern>config.yml</ignoredResourcePattern>
                            </ignoredResourcePatterns>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <forceLegacyJavacApi>true</forceLegacyJavacApi>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                    <configuration>
                        <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar -Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>net.bytebuddy</groupId>
                            <artifactId>byte-buddy-agent</artifactId>
                            <version>${bytebuddy.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.version}</version>
                    <configuration>
                        <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar -Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>net.bytebuddy</groupId>
                            <artifactId>byte-buddy-agent</artifactId>
                            <version>${bytebuddy.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>platform-acceptance</id>
            <modules>
                <module>dataregistry-platform-acceptance</module>
            </modules>
        </profile>
    </profiles>
</project>
