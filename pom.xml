<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>nl.hauntedmc.dataregistry</groupId>
    <artifactId>dataregistry-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>DataRegistry</name>
    <description>Keeps up-to-date player data records, game-state metadata, and related events.</description>
    <url>https://github.com/HauntedMC/DataRegistry</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - DataRegistry</name>
            <url>https://maven.pkg.github.com/HauntedMC/DataRegistry</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>dataregistry-api</module>
        <module>dataregistry-platform-common</module>
        <module>dataregistry-migrations</module>
        <module>dataregistry-core</module>
        <module>dataregistry-platform-velocity</module>
        <module>dataregistry-platform-paper</module>
        <module>dataregistry-testkit</module>
    </modules>

    <properties>
        <!-- Project identity and compiler configuration. -->
        <revision>1.13.1</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <!-- Runtime and platform APIs. -->
        <dataprovider.version>3.1.6</dataprovider.version>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <snakeyaml.version>2.6</snakeyaml.version>
        <paper.version>26.2.build.84-stable</paper.version>
        <paper.runtime.version>26.2</paper.runtime.version>
        <paper.runtime.build>65</paper.runtime.build>
        <paper.runtime.sha256>d290ee2a3ae92fea10afb0c74f797023d74cfd72cbcee44314e0c50d5551f2c6</paper.runtime.sha256>
        <velocity.version>4.1.0-SNAPSHOT</velocity.version>
        <velocity.runtime.build>9</velocity.runtime.build>
        <velocity.runtime.sha256>635ffe27b4fe1b97e61479012121d4e7c61a9eec99e6bd5a1f923053c2a259ce</velocity.runtime.sha256>
        <adventure.version>5.2.0</adventure.version>
        <!-- Test libraries. -->
        <junit.version>6.1.2</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <bytebuddy.version>1.18.11</bytebuddy.version>
        <testcontainers.version>1.21.4</testcontainers.version>

        <!-- Build plugins and their plugin dependencies. -->
        <flatten.plugin.version>1.8.0</flatten.plugin.version>
        <maven.enforcer.version>3.6.3</maven.enforcer.version>
        <maven.checkstyle.plugin.version>3.6.0</maven.checkstyle.plugin.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <checkstyle.version>13.8.0</checkstyle.version>
        <maven.shade.version>3.6.2</maven.shade.version>
        <maven.jar.version>3.5.1</maven.jar.version>
        <maven.clean.version>3.5.0</maven.clean.version>
        <maven.resources.version>3.5.0</maven.resources.version>
        <maven.install.version>3.1.4</maven.install.version>
        <maven.deploy.version>3.1.4</maven.deploy.version>
        <maven.surefire.version>3.5.6</maven.surefire.version>
        <maven.failsafe.version>3.5.6</maven.failsafe.version>
        <exec.maven.plugin.version>3.6.2</exec.maven.plugin.version>
        <duplicate.finder.version>2.0.1</duplicate.finder.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <repositories>
        <!-- Prefer Maven Central for public artifacts; GitHub hosts HauntedMC releases. -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/HauntedMC/DataProvider</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.kyori</groupId>
                <artifactId>adventure-bom</artifactId>
                <version>${adventure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Publish consumer POMs with CI-friendly versions resolved. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten.plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten-pom</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>clean-flattened-pom</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[25,26.1)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.8.6,)</version></requireMavenVersion>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>net.kyori:adventure-api:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-key:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-nbt:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-resource-pack:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-serializer-configurate4:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-logger-slf4j:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-minimessage:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-ansi:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-commons:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-gson:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-gson-legacy-impl:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-json:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-json-legacy-impl:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-legacy:[0,5.0.0)</exclude>
                                        <exclude>net.kyori:adventure-text-serializer-plain:[0,5.0.0)</exclude>
                                    </excludes>
                                    <message>Adventure 4.x core modules are not supported. Keep the Adventure core dependency graph on 5.x.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven.checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <consoleOutput>true</consoleOutput>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>checkstyle-verify</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-coverage-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>generate-coverage-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>enforce-coverage-minimum</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.15</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <version>${duplicate.finder.version}</version>
                <executions>
                    <execution>
                        <id>reject-duplicate-classes</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <failBuildInCaseOfDifferentContentConflict>true</failBuildInCaseOfDifferentContentConflict>
                            <failBuildInCaseOfEqualContentConflict>true</failBuildInCaseOfEqualContentConflict>
                            <!-- DataProvider's test-only runtime dependency has its own unrelated default config. -->
                            <ignoredResourcePatterns>
                                <ignoredResourcePattern>config.yml</ignoredResourcePattern>
                            </ignoredResourcePatterns>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Queue Maven publication until every final-reactor verification gate has passed. -->
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration><deployAtEnd>true</deployAtEnd></configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <forceLegacyJavacApi>true</forceLegacyJavacApi>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                    <configuration>
                        <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar -Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>net.bytebuddy</groupId>
                            <artifactId>byte-buddy-agent</artifactId>
                            <version>${bytebuddy.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.version}</version>
                    <configuration>
                        <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar -Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>net.bytebuddy</groupId>
                            <artifactId>byte-buddy-agent</artifactId>
                            <version>${bytebuddy.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>platform-acceptance</id>
            <modules>
                <module>dataregistry-platform-acceptance</module>
            </modules>
        </profile>
    </profiles>
</project>
